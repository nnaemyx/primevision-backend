# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Use a long random string, e.g.: openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_key

# ─── Resend Email ─────────────────────────────────────────────────────────────
# 1. Create account at https://resend.com
# 2. Go to API Keys → Create API Key
# 3. Go to Domains → Add Domain → verify your domain's DNS records
# 4. Once domain is verified, emails will send from noreply@yourdomain.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address — must match your verified Resend domain
# Until domain is verified, use: onboarding@resend.dev (only sends to your own email)
FROM_EMAIL=noreply@crestlinetrades.com

# Admin email to receive support chat notifications
ADMIN_EMAIL=admin@crestlinetrades.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
FRONTEND_URL=https://crestlinetrades.com
